  "item": [
    {
      "name": "GET - Retrieve Employee Details",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code should be 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Email field should exist\", function () {\r",
              "    pm.expect(response).to.have.property(\"email\");\r",
              "});\r",
              "\r",
              "pm.test(\"Email should not be empty\", function () {\r",
              "    pm.expect(response.email).to.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Email should have a valid format\", function () {\r",
              "    pm.expect(response.email).to.match(\r",
              "        /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/\r",
              "    );\r",
              "});\r",
              "\r",
              "pm.test(\"API should return the requested user ID\", function () {\r",
              "    pm.expect(response.id).to.equal(1);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://dummyjson.com/users/1",
          "protocol": "https",
          "host": [
            "dummyjson",
            "com"
          ],
          "path": [
            "users",
            "1"
          ]
        }
      },
      "response": []
